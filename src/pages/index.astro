---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModelCard from "../components/ModelCard.astro";
import { models } from "../data/models";
---

<BaseLayout
  title="Abbott Brothers Development | Premium ADUs"
  description="Thoughtfully designed prefabricated ADUs, personalized for your property and lifestyle."
>
  <section class="hero">
    <div class="hero__inner page-width">
      <div class="hero__copy">
        <p class="eyebrow">Abbott Brothers Development</p>

        <h1 class="display">
          Timeless spaces.<br />
          Made for the way you live.
        </h1>

        <p class="lede">
          Thoughtfully designed ADUs with a simpler path from
          inspiration to a finished space on your property.
        </p>

        <div class="hero__actions">
          <a class="button" href="#models">Explore the Models</a>
          <a class="button button--secondary" href="/contact/">
            Request a Quote
          </a>
        </div>
      </div>

      <div class="hero__media">
        <img
          src="/assets/images/hero-pool-exterior.webp"
          alt="Abbott Brothers ADU beside a landscaped backyard pool"
        />
      </div>
    </div>
  </section>

  <section class="section intro">
    <div class="page-width intro__grid">
      <p class="eyebrow">A better way to add space</p>

      <div>
        <h2 class="heading">
          Start with a proven design. Make it your own.
        </h2>

        <p class="lede">
          Choose the ADU that fits your property and your plans.
          Abbott Brothers coordinates the design selections, site
          preparation, manufacturing, delivery, and finishing that
          turn it into a place that feels like yours.
        </p>
      </div>
    </div>
  </section>

  <section id="models" class="section models">
    <div class="page-width">
      <p class="eyebrow">The collection</p>
      <h2 class="heading">Three starting points.</h2>

      <div class="models__grid">
        {models.map((model) => <ModelCard model={model} />)}
      </div>

      <div class="models__all">
        <a class="button button--secondary" href="/models/">
          View All Models
        </a>
      </div>
    </div>
  </section>

  <section id="process" class="section process">
    <div class="page-width">
      <p class="eyebrow">From idea to your property</p>
      <h2 class="heading">A coordinated path from design to delivery.</h2>

      <div class="process__grid">
        <div>
          <span>01</span>
          <h3>Choose</h3>
          <p>Start with the model that best fits your property and intended use.</p>
        </div>

        <div>
          <span>02</span>
          <h3>Personalize</h3>
          <p>Shape the finishes, furnishings, and character of your space.</p>
        </div>

        <div>
          <span>03</span>
          <h3>Prepare</h3>
          <p>Abbott Brothers coordinates the local infrastructure and site work.</p>
        </div>

        <div>
          <span>04</span>
          <h3>Manufacture</h3>
          <p>The structure is prefabricated off-site in a controlled environment.</p>
        </div>

        <div>
          <span>05</span>
          <h3>Deliver</h3>
          <p>The finished structure is transported and placed on the prepared site.</p>
        </div>

        <div>
          <span>06</span>
          <h3>Finish</h3>
          <p>Abbott Brothers brings the selected interior and furnishing package together.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section manufacture">
    <div class="page-width manufacture__grid">
      <div class="offsite-card" aria-label="Off-site fabrication process">
        <div class="offsite-card__header">
          <p class="offsite-card__eyebrow">Manufacturing partner</p>
          <h3 class="offsite-card__title">Off-site fabrication</h3>
          <p class="offsite-card__meta">
            Las Vegas, Nevada
          </p>
        </div>

        <div class="offsite-card__steps">
          <div class="offsite-step">
            <span class="offsite-step__number">01</span>

            <div>
              <h4>Fabricate</h4>
              <p>
                The structural shell is built off-site in a controlled
                manufacturing environment.
              </p>
            </div>
          </div>

          <div class="offsite-step">
            <span class="offsite-step__number">02</span>

            <div>
              <h4>Deliver</h4>
              <p>
                The completed structure is transported to the prepared
                property when the site is ready.
              </p>
            </div>
          </div>

          <div class="offsite-step">
            <span class="offsite-step__number">03</span>

            <div>
              <h4>Finish</h4>
              <p>
                Abbott Brothers coordinates placement, final work,
                furnishings, and finishing touches.
              </p>
            </div>
          </div>
        </div>

      </div>

      <div>
        <p class="eyebrow">Built off-site</p>
        <h2 class="heading">Less construction in your backyard.</h2>

        <p class="lede">
          The structural building is manufactured off-site in Las Vegas,
          Nevada while the property is prepared for its arrival. Abbott
          Brothers coordinates the path from fabrication through delivery,
          installation, and finishing.
        </p>
      </div>
    </div>
  </section>

  <section class="section streamlined">
    <div class="page-width streamlined__grid">
      <div>
        <p class="eyebrow">Streamlined by design</p>

        <h2 class="heading">
          Designed to support a simpler permitting and installation path.
        </h2>
      </div>

      <div class="streamlined__copy">
        <p>
          Our prefabricated ADUs are developed around a coordinated off-site
          construction approach intended to reduce complexity from planning
          through installation. Final permitting, inspections, and site
          requirements remain subject to local jurisdiction requirements.
        </p>

        <p>
          By completing the majority of construction off-site, we reduce
          disruption to the property, shorten on-site construction activity,
          and provide a more efficient alternative to traditional building
          methods.
        </p>

        <p class="streamlined__closing">
          Thoughtfully Built. Seamlessly Delivered.
        </p>
      </div>
    </div>
  </section>

  <section class="section property">
    <div class="page-width">
      <p class="eyebrow">Made for your property</p>
      <h2 class="heading">
        Guest house. Pool house.<br />
        Office. Retreat. Yours.
      </h2>

      <div class="property__media">
        <img
          src="/assets/images/exterior-rooftop-aerial.webp"
          alt="Aerial view of an ADU with rooftop terrace and backyard pool"
        />
      </div>
    </div>
  </section>

  <section class="section living">
    <div class="page-width living__grid">
      <div>
        <p class="eyebrow">Designed to live in</p>
        <h2 class="heading">The details matter inside, too.</h2>

        <p class="lede">
          Thoughtful kitchens, comfortable living spaces, bedrooms,
          baths, and finishes turn a prefabricated structure into a
          space that belongs on your property.
        </p>
      </div>

      <div class="living__media">
        <img
          src="/assets/images/interior-kitchen-entertaining.webp"
          alt="Bright ADU interior with kitchen and entertaining space"
        />
      </div>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="page-width about__grid">
      <div>
        <p class="eyebrow">Abbott Brothers</p>
        <img
          class="about__monogram"
          src="/assets/brand/ab-monogram.png"
          alt=""
          aria-hidden="true"
        />
      </div>

      <h2 class="heading">
        We simplify the build so you can focus on the space.
      </h2>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="page-width contact__inner">
      <p class="eyebrow">Start a conversation</p>

      <h2 class="heading">Have a property in mind?</h2>

      <p class="lede">
        Tell us what you are considering and which model interests you.
      </p>

      <a class="button contact__button" href="/contact/">
        Request a Quote
      </a>
    </div>
  </section>
</BaseLayout>

<style>

  .hero {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .hero__inner {
    display: grid;
    min-height: calc(100vh - 10rem);
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.25rem;
  }

  .hero__media {
    min-height: min(68vh, 48rem);
    overflow: hidden;
  }

  .hero__media img,
  .property__media img,
  .living__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__media img {
    min-height: min(68vh, 48rem);
  }

  .intro {
    border-top: 1px solid rgba(38, 50, 41, 0.12);
  }

  .intro__grid,
  .about__grid {
    display: grid;
    grid-template-columns: minmax(10rem, 0.6fr) minmax(0, 1.5fr);
    gap: 3rem;
  }

  .models {
    background: var(--color-ivory-soft);
  }

  .models__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
    margin-top: 4rem;
  }

  .models__all {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }

  .process {
    background: var(--color-olive);
    color: var(--color-ivory);
  }

  .process .eyebrow {
    color: var(--color-gold-soft);
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 4rem;
    border-top: 1px solid rgba(244, 240, 231, 0.22);
    border-left: 1px solid rgba(244, 240, 231, 0.22);
  }

  .process__grid > div {
    min-height: 15rem;
    padding: 2rem;
    border-right: 1px solid rgba(244, 240, 231, 0.22);
    border-bottom: 1px solid rgba(244, 240, 231, 0.22);
  }

  .process__grid span {
    color: var(--color-gold-soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .process__grid h3 {
    margin: 2rem 0 0.6rem;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 400;
  }

  .process__grid p {
    margin: 0;
    color: rgba(244, 240, 231, 0.68);
  }

  .manufacture__grid,
  .living__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .offsite-card {
    display: grid;
    gap: 1.6rem;
    min-height: 24rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border: 1px solid rgba(38, 50, 41, 0.16);
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.42),
        rgba(168, 137, 88, 0.06)
      );
  }

  .offsite-card__header {
    display: grid;
    gap: 0.35rem;
  }

  .offsite-card__eyebrow {
    margin: 0;
    color: var(--color-gold);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .offsite-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 400;
  }

  .offsite-card__meta {
    margin: 0;
    color: var(--color-olive-soft);
    font-size: 0.86rem;
  }

  .offsite-card__steps {
    display: grid;
  }

  .offsite-step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(38, 50, 41, 0.14);
  }

  .offsite-step__number {
    color: var(--color-gold);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .offsite-step h4 {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
  }

  .offsite-step p {
    margin: 0;
    color: var(--color-olive-soft);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .offsite-card__link {
    display: inline-flex;
    gap: 0.4rem;
    width: fit-content;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid rgba(38, 50, 41, 0.35);
    color: var(--color-olive);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .offsite-card__link:hover {
    opacity: 0.65;
  }

  .property {
    background: var(--color-ivory-soft);
  }

  .property__media {
    height: min(65vh, 44rem);
    margin-top: 3rem;
    overflow: hidden;
  }

  .living__media {
    min-height: 24rem;
    overflow: hidden;
  }

  .living__media img {
    min-height: 24rem;
  }

  .about {
    border-top: 1px solid rgba(38, 50, 41, 0.12);
  }

  .about__monogram {
    width: 7rem;
    margin-top: 1.75rem;
    opacity: 0.92;
  }

  .contact {
    background: var(--color-gold);
    color: var(--color-ink);
  }

  .contact__inner {
    text-align: center;
  }

  .contact .eyebrow {
    color: rgba(29, 33, 30, 0.65);
  }

  .contact .lede {
    margin-inline: auto;
  }

  .contact__button {
    margin-top: 2.5rem;
  }

  @media (max-width: 900px) {
    .hero__inner,
    .manufacture__grid,
    .living__grid {
      grid-template-columns: 1fr;
    }

    .hero__inner {
      min-height: auto;
    }

    .hero__media {
      min-height: 32rem;
    }

    .models__grid,
    .process__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 650px) {
    .intro__grid,
    .about__grid,
    .models__grid,
    .process__grid {
      grid-template-columns: 1fr;
    }

    .hero__media {
      min-height: 26rem;
    }

    .property__media {
      min-height: 25rem;
    }
  }

  .streamlined {
    border-top: 1px solid rgba(38, 50, 41, 0.1);
    background: var(--color-ivory-soft);
  }

  .streamlined__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .streamlined__copy {
    display: grid;
    gap: 1.25rem;
    color: var(--color-olive-soft);
  }

  .streamlined__copy p {
    margin: 0;
  }

  .streamlined__closing {
    margin-top: 0.6rem !important;
    color: var(--color-olive) !important;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.1;
  }

  @media (max-width: 800px) {
    .streamlined__grid {
      grid-template-columns: 1fr;
    }
  }

</style>
