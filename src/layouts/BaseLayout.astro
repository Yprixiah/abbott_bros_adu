---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Abbott Brothers Development",
  description = "Premium prefabricated ADUs designed around the way you live.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(
  "/assets/images/hero-pool-exterior.webp",
  Astro.site
);

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": "https://adu.abbottdevelopment.com/#organization",
  name: "Abbott Brothers Development",
  url: "https://adu.abbottdevelopment.com/",
  logo: "https://adu.abbottdevelopment.com/assets/brand/ab-banner.png",
  image: "https://adu.abbottdevelopment.com/assets/images/hero-pool-exterior.webp",
  description:
    "Thoughtfully designed prefabricated ADUs with a coordinated path from planning through delivery and finishing.",
  areaServed: {
    "@type": "State",
    name: "California",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Analytics -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-4Y5DJJ2CBF"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;

      gtag("js", new Date());
      gtag("config", "G-4Y5DJJ2CBF");
    </script>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="generator" content={Astro.generator} />


    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Abbott Brothers Development" />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content="Abbott Brothers Development ADU beside a landscaped backyard pool"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(businessSchema)}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const validModels = new Set(["olive", "cypress", "laurel"]);

        function sendEvent(name, params = {}) {
          if (typeof window.gtag !== "function") return;
          window.gtag("event", name, params);
        }

        // --------------------------------------------------
        // Model detail views
        // --------------------------------------------------

        const modelMatch = window.location.pathname.match(
          /^\/models\/(olive|cypress|laurel)\/?$/
        );

        if (modelMatch) {
          sendEvent("view_model", {
            model: modelMatch[1],
          });
        }

        // --------------------------------------------------
        // Entry into quote flow
        // --------------------------------------------------

        document.addEventListener("click", (event) => {
          const target = event.target;

          if (!(target instanceof Element)) return;

          const link = target.closest('a[href*="/contact/"]');

          if (!(link instanceof HTMLAnchorElement)) return;

          const destination = new URL(link.href, window.location.origin);
          const requestedModel = destination.searchParams.get("model");

          const params = {
            source_page: window.location.pathname,
          };

          if (requestedModel && validModels.has(requestedModel)) {
            params.model = requestedModel;
          }

          sendEvent("quote_start", params);
        });

        // --------------------------------------------------
        // Valid quote-form submissions
        // --------------------------------------------------

        document.addEventListener("submit", (event) => {
          const form = event.target;

          if (!(form instanceof HTMLFormElement)) return;
          if (form.id !== "quote-form") return;
          if (!form.checkValidity()) return;

          const data = new FormData(form);

          const model = data.get("model");
          const intendedUse = data.get("use");
          const timeline = data.get("timeline");

          const params = {};

          if (typeof model === "string" && validModels.has(model)) {
            params.model = model;
          }

          if (typeof intendedUse === "string" && intendedUse) {
            params.intended_use = intendedUse;
          }

          if (typeof timeline === "string" && timeline) {
            params.timeline = timeline;
          }

          sendEvent("quote_submit", params);
        });
      })();
    </script>
  </body>
</html>
